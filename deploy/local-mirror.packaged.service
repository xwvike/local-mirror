# 由 deb/rpm 投递到 /lib/systemd/system/local-mirror.service —— 开箱即用，无需编辑。
#
#   1. 编辑 /etc/local-mirror/config.yml（装包时已创建，升级不覆盖）
#   2. sudo systemctl enable --now local-mirror
#
# 包不会自动 enable/start：配置装出来是空白的，起来必然失败。
#
# ⚠️ 默认以 root 运行——同步汇端常需保留任意属主的文件。要降权请用 drop-in，
# 不要直接改本文件（升级会覆盖）：
#   sudo systemctl edit local-mirror
#   [Service]
#   User=someone
#   Group=someone
#
# 降权后还必须做一步：配置文件由包安装为 root:root 0600，非 root 用户读不到，
# 服务会起不来。把它交给该用户（权限仍保持 0600，里面有 secret）：
#   sudo chown someone:someone /etc/local-mirror/config.yml
# 该用户同样须对配置里每个 path 可读写。
#
# 本文件的内容与 `local-mirror service install` 生成的完全一致，
# 由 TestPackagedUnitMatchesGenerator 守住，改一处必须改另一处。

[Unit]
Description=local-mirror directory sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/local-mirror --config /etc/local-mirror/config.yml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
